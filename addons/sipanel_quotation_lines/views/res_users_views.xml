<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- owner review 2026-10-12: Persian salesperson name for fa_IR quotations, next to the user's signature -->
    <record id="view_users_form_sipanel_quotation_name" model="ir.ui.view">
        <field name="name">res.users.form.sipanel.quotation.name</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='signature']" position="before">
                <field name="sipanel_quotation_name_fa"/>
            </xpath>
        </field>
    </record>
</odoo>
