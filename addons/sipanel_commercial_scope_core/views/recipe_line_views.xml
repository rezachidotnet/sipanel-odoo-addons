<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sipanel_recipe_line_form" model="ir.ui.view">
        <field name="name">sipanel.scope.recipe.line.form</field>
        <field name="model">sipanel.scope.recipe.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="version_id"/>
                            <field name="occurrence_key"/>
                            <field name="kind"/>
                            <field name="product_id"/>
                            <field name="internal_description"/>
                            <field name="uom_id"/>
                            <field name="dimension_family"/>
                        </group>
                        <group>
                            <field name="basis"/>
                            <field name="rate"/>
                            <field name="fixed_qty"/>
                            <field name="manual_qty_default"/>
                            <field name="percent"/>
                            <field name="base_line_ids" widget="many2many_tags"/>
                            <field name="rounding_increment"/>
                            <field name="rounding_mode"/>
                        </group>
                        <group>
                            <field name="activity_id"/>
                            <field name="execution_mode"/>
                            <field name="no_action_reason"/>
                            <field name="cost_policy"/>
                            <field name="manual_cost_default" groups="sipanel_commercial_scope_core.group_scope_cost_viewer"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="customer_label"/>
                            <field name="customer_eligible"/>
                            <field name="responsibility"/>
                            <field name="placement"/>
                            <field name="certainty"/>
                            <field name="disclosure"/>
                            <field name="resolution_owner_id"/>
                            <field name="resolution_note"/>
                        </group>
                    </group>
                    <field name="spec_json" widget="json"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
