<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sipanel_scope_list" model="ir.ui.view">
        <field name="name">sipanel.scope.list</field>
        <field name="model">sipanel.scope</field>
        <field name="arch" type="xml">
            <list>
                <field name="is_favorite" widget="boolean_favorite" nolabel="1"/>
                <field name="code"/>
                <field name="name"/>
                <field name="current_version_id"/>
                <field name="owner_user_id"/>
                <field name="usage_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_sipanel_scope_form" model="ir.ui.view">
        <field name="name">sipanel.scope.form</field>
        <field name="model">sipanel.scope</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_new_version" type="object" string="New version" class="btn-primary" groups="sipanel_commercial_scope_core.group_scope_steward"/>
                    <button name="action_duplicate_as_new_scope" type="object" string="Duplicate as new Scope" groups="sipanel_commercial_scope_core.group_scope_steward"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_versions" type="object" class="oe_stat_button" icon="fa-code-fork">
                            <field name="version_count" widget="statinfo" string="Versions"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="owner_user_id"/>
                            <field name="is_favorite" widget="boolean_favorite"/>
                        </group>
                        <group>
                            <field name="current_version_id"/>
                            <field name="usage_count"/>
                            <field name="duplicated_from_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Versions">
                            <field name="version_ids" readonly="1">
                                <list>
                                    <field name="revision"/>
                                    <field name="state" widget="badge"/>
                                    <field name="customer_label"/>
                                    <field name="anchor_product_id"/>
                                    <field name="released_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_sipanel_scope" model="ir.actions.act_window">
        <field name="name">Commercial Scopes</field>
        <field name="res_model">sipanel.scope</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
