<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Numeric thresholds are TBE: keys are created empty/neutral and must be set by configuration. -->
        <record id="param_release_retry_count" model="ir.config_parameter">
            <field name="key">sipanel_scope.release_retry_count</field>
            <field name="value">3</field>
        </record>
        <record id="param_company_currency_only" model="ir.config_parameter">
            <field name="key">sipanel_scope.company_currency_only</field>
            <field name="value">True</field>
        </record>
    </data>
</odoo>
