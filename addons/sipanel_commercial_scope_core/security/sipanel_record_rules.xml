<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_scope_company" model="ir.rule">
            <field name="name">SIPANEL scope: company</field>
            <field name="model_id" ref="model_sipanel_scope"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_scope_version_company" model="ir.rule">
            <field name="name">SIPANEL scope version: company</field>
            <field name="model_id" ref="model_sipanel_scope_version"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_scope_version_released_for_non_steward" model="ir.rule">
            <field name="name">SIPANEL scope version: drafts only for steward/auditor</field>
            <field name="model_id" ref="model_sipanel_scope_version"/>
            <field name="domain_force">['|', ('state', '!=', 'draft'), '|', ('create_uid', '=', user.id), ('scope_id.owner_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_scope_version_steward_all" model="ir.rule">
            <field name="name">SIPANEL scope version: steward/auditor see drafts</field>
            <field name="model_id" ref="model_sipanel_scope_version"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_scope_steward')), (4, ref('group_scope_auditor')), (4, ref('group_scope_estimator'))]"/>
        </record>
        <record id="rule_recipe_line_company" model="ir.rule">
            <field name="name">SIPANEL recipe line: company</field>
            <field name="model_id" ref="model_sipanel_scope_recipe_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_audit_event_company" model="ir.rule">
            <field name="name">SIPANEL audit event: company</field>
            <field name="model_id" ref="model_sipanel_scope_audit_event"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_favorite_own" model="ir.rule">
            <field name="name">SIPANEL favorite: own</field>
            <field name="model_id" ref="model_sipanel_scope_favorite"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>
    </data>
</odoo>
