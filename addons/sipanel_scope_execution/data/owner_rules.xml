<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default registry (SV-13): storable products and task-creating services are NATIVE_LINE_OWNER;
             services with tracking 'no' or 'project_only' are COMPONENT_BRIDGE_OWNER (BQ-05=A, BQ-07=A). -->
        <record id="owner_rule_default_service_no" model="sipanel.execution.owner.rule">
            <field name="sequence">10</field>
            <field name="service_tracking">no</field>
            <field name="route_kind">none</field>
            <field name="owner">component_bridge_owner</field>
        </record>
        <record id="owner_rule_default_service_project_only" model="sipanel.execution.owner.rule">
            <field name="sequence">20</field>
            <field name="service_tracking">project_only</field>
            <field name="route_kind">project_task</field>
            <field name="owner">component_bridge_owner</field>
        </record>
        <record id="owner_rule_default_task_global" model="sipanel.execution.owner.rule">
            <field name="sequence">30</field>
            <field name="service_tracking">task_global_project</field>
            <field name="route_kind">project_task</field>
            <field name="owner">native_line_owner</field>
        </record>
        <record id="owner_rule_default_task_in_project" model="sipanel.execution.owner.rule">
            <field name="sequence">40</field>
            <field name="service_tracking">task_in_project</field>
            <field name="route_kind">project_task</field>
            <field name="owner">native_line_owner</field>
        </record>
        <record id="owner_rule_default" model="sipanel.execution.owner.rule">
            <field name="sequence">100</field>
            <field name="route_kind">stock_rule</field>
            <field name="owner">native_line_owner</field>
        </record>
    </data>
</odoo>
