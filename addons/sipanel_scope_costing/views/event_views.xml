<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_event_list" model="ir.ui.view">
        <field name="name">sipanel.actual.cost.event.list</field>
        <field name="model">sipanel.actual.cost.event</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-muted="inclusion != 'included'">
                <field name="event_date"/><field name="route"/><field name="source_model"/><field name="source_display"/><field name="component_type"/><field name="layer"/><field name="inclusion"/>
                <field name="amount"/><field name="allocated_amount"/><field name="unallocated_amount"/><field name="allocation_state" widget="badge"/><field name="project_id"/><field name="qty"/><field name="qty_kind"/><field name="cost_source_zero"/><field name="reversal_of_id"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="view_event_form" model="ir.ui.view">
        <field name="name">sipanel.actual.cost.event.form</field>
        <field name="model">sipanel.actual.cost.event</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group><field name="source_model"/><field name="source_res_id"/><field name="source_display"/><field name="policy_id"/><field name="route"/><field name="component_type"/><field name="layer"/><field name="inclusion"/></group>
                        <group><field name="amount"/><field name="allocated_amount"/><field name="unallocated_amount"/><field name="allocation_state"/><field name="event_date"/><field name="project_id"/><field name="system_id"/><field name="activity_id"/><field name="qty"/><field name="uom_id"/><field name="qty_kind"/><field name="reversal_of_id"/><field name="cost_source_zero"/><field name="currency_id" invisible="1"/></group>
                    </group>
                    <field name="allocation_ids" readonly="1">
                        <list><field name="allocation_basis"/><field name="quote_scope_id"/><field name="demand_id"/><field name="component_id"/><field name="amount"/><field name="reviewer_id"/><field name="reason"/></list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_event" model="ir.actions.act_window">
        <field name="name">Actual Cost Events</field>
        <field name="res_model">sipanel.actual.cost.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
