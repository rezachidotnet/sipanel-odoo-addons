<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_policy_list" model="ir.ui.view">
        <field name="name">sipanel.cost.recognition.policy.list</field>
        <field name="model">sipanel.cost.recognition.policy</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="route"/><field name="version"/><field name="terminal_event_model"/><field name="state" widget="badge"/><field name="approved_by_id"/><field name="approved_date"/></list>
        </field>
    </record>
    <record id="view_policy_form" model="ir.ui.view">
        <field name="name">sipanel.cost.recognition.policy.form</field>
        <field name="model">sipanel.cost.recognition.policy</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve (Finance)" class="btn-primary" invisible="state != 'draft'" groups="sipanel_scope_costing.group_scope_finance"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group><field name="route"/><field name="version"/><field name="terminal_event_model"/><field name="commitment_model"/><field name="operational_qty_model"/><field name="wip_reporting"/></group>
                        <group><field name="approved_by_id"/><field name="approved_date"/><field name="approval_source"/><field name="effective_from"/><field name="company_id" groups="base.group_multi_company"/></group>
                    </group>
                    <field name="terminal_event_filter_json" widget="json"/>
                    <field name="excluded_models_json" widget="json"/>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_policy" model="ir.actions.act_window">
        <field name="name">Cost Recognition Policies</field>
        <field name="res_model">sipanel.cost.recognition.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
