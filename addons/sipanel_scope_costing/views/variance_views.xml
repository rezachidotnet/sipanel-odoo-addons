<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_variance_list" model="ir.ui.view">
        <field name="name">sipanel.scope.variance.list</field>
        <field name="model">sipanel.scope.variance</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="quote_scope_id"/><field name="order_id"/><field name="project_id"/><field name="system_id"/>
                <field name="baseline_cost"/><field name="forecast_cost"/><field name="committed_amount"/><field name="recognised_cost"/><field name="variance_amount"/>
                <field name="recognised_revenue"/><field name="recognised_margin"/><field name="unallocated_cost"/><field name="completeness" widget="badge"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_variance" model="ir.actions.act_window">
        <field name="name">Scope Variance</field>
        <field name="res_model">sipanel.scope.variance</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
